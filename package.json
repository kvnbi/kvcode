{
  "name": "kvcode",
  "version": "0.1.0",
  "description": "A minimal code editor built on Electron, React and Monaco",
  "main": "./out/main/index.js",
  "author": "Kevin",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "test": "node --test \"src/**/*.test.ts\"",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "install:electron-binary": "node scripts/install-electron-binary.mjs",
    "install:node-pty": "node scripts/install-node-pty.mjs",
    "postinstall": "node scripts/install-node-pty.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "openai": "^7.8.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@44.0.0": true
  }
}
